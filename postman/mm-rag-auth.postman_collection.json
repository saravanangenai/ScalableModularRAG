{
  "info": {
    "name": "MM-RAG Auth (011-auth-and-workspaces, single-tenant per 012)",
    "_postman_id": "mm-rag-auth-011",
    "description": "Exercises apps/api's auth + workspace/membership/api-key routes against real Keycloak + Postgres (no mocks). Single-tenant as-built (specs/012): no /tenants routes. Run folders top to bottom on a fresh run: Auth -> Workspaces & Members -> API Keys -> Negative/RBAC.\n\nSetup:\n1. Import the companion environment file (mm-rag-local.postman_environment.json) and select it.\n2. Fill in `client_secret` from infra/.env's KEYCLOAK_TEST_CLIENT_SECRET (left blank here deliberately — never commit a real secret into this file).\n3. Make sure apps/api is running (`uv run uvicorn apps.api.main:app --host 127.0.0.1 --port 8000`) and Keycloak is running (`http://localhost:8080`).\n\nKnown gap: there is no GET /me endpoint yet, so getting User 2's *internal* user id (needed for the 'Add Workspace Member' request) requires a direct DB lookup after User 2's first authenticated call (JIT-provisioning) has run:\n  psql -U mmrag -h localhost -d mmrag -c \"SELECT id FROM users WHERE email = 'testuser2@example.com';\"\nPaste that id into the `user2_internal_id` variable. See the 'Add Workspace Member (user2)' request description for the exact step.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "keycloak_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "realm", "value": "mm-rag", "type": "string" },
    { "key": "client_id", "value": "mm-rag-api", "type": "string" },
    { "key": "client_secret", "value": "", "type": "string" },
    { "key": "user1_username", "value": "testuser", "type": "string" },
    { "key": "user1_password", "value": "testuser-changeme", "type": "string" },
    { "key": "user2_username", "value": "testuser2", "type": "string" },
    { "key": "user2_password", "value": "testuser2-changeme", "type": "string" },
    { "key": "access_token_1", "value": "", "type": "string" },
    { "key": "access_token_2", "value": "", "type": "string" },
    { "key": "user2_internal_id", "value": "", "type": "string" },
    { "key": "workspace_id", "value": "", "type": "string" },
    { "key": "api_key_id", "value": "", "type": "string" },
    { "key": "api_key_plaintext", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0 - Health",
      "item": [
        {
          "name": "Health check (no auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Auth (Keycloak token minting)",
      "item": [
        {
          "name": "Get Token - User 1 (testuser)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" },
                { "key": "username", "value": "{{user1_username}}" },
                { "key": "password", "value": "{{user1_password}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token_1', json.access_token);",
                  "pm.test('access_token present', () => pm.expect(json.access_token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Token - User 2 (testuser2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" },
                { "key": "username", "value": "{{user2_username}}" },
                { "key": "password", "value": "{{user2_password}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token_2', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Provision User 2 (any authed call JIT-creates the users row)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_2}}" }] },
            "url": { "raw": "{{base_url}}/workspaces", "host": ["{{base_url}}"], "path": ["workspaces"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Workspaces & Members",
      "item": [
        {
          "name": "Create Workspace (any authed user -> becomes owner)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": { "raw": "{{base_url}}/workspaces", "host": ["{{base_url}}"], "path": ["workspaces"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Workspace {{$randomUUID}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('workspace_id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Workspaces",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": { "raw": "{{base_url}}/workspaces", "host": ["{{base_url}}"], "path": ["workspaces"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('includes created workspace', () => {",
                  "  const ids = pm.response.json().map(w => w.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('workspace_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Workspace Member (user2 as viewer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "members"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user2_internal_id}}\",\n  \"role\": \"viewer\"\n}"
            },
            "description": "REQUIRES `user2_internal_id` to be set first:\n1. Run '1 - Auth' fully (including 'Provision User 2') so User 2's `users` row exists.\n2. Look up their internal id: `psql -U mmrag -h localhost -d mmrag -c \"SELECT id FROM users WHERE email = 'testuser2@example.com';\"`\n3. Set the `user2_internal_id` collection variable to that UUID.\nThere is no GET /me endpoint yet to automate this step."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - API Keys",
      "item": [
        {
          "name": "Create API Key (workspace owner)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/api-keys",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "api-keys"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"scopes\": [\"documents:read\"]\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('key has mmrag_ prefix', () => pm.expect(json.key).to.match(/^mmrag_/));",
                  "pm.collectionVariables.set('api_key_id', json.id);",
                  "pm.collectionVariables.set('api_key_plaintext', json.key);"
                ]
              }
            }
          ]
        },
        {
          "name": "Use API Key (as bearer credential)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key_plaintext}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "documents"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "List API Keys (never exposes hash/plaintext)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/api-keys",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "api-keys"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no key material exposed', () => {",
                  "  for (const k of pm.response.json()) {",
                  "    pm.expect(k).to.not.have.property('key');",
                  "    pm.expect(k).to.not.have.property('key_hash');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/api-keys/{{api_key_id}}",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "api-keys", "{{api_key_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"] }
            }
          ]
        },
        {
          "name": "Use Revoked API Key -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{api_key_plaintext}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "documents"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Negative & RBAC",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/workspaces", "host": ["{{base_url}}"], "path": ["workspaces"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "Garbage token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "not-a-real-jwt" }] },
            "url": { "raw": "{{base_url}}/workspaces", "host": ["{{base_url}}"], "path": ["workspaces"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "Valid token, not a workspace member -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_1}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/00000000-0000-0000-0000-000000000000/documents",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "00000000-0000-0000-0000-000000000000", "documents"]
            },
            "description": "Random workspace id nobody belongs to. Per 06-security-model.md §5, this must be 404, not 403 — a non-member can't distinguish 'doesn't exist' from 'exists but you can't see it'."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));"] }
            }
          ]
        },
        {
          "name": "Viewer role, insufficient for owner action -> 403",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_2}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "members"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{user2_internal_id}}\",\n  \"role\": \"editor\"\n}" },
            "description": "Requires 'Add Workspace Member (user2 as viewer)' to have run first (user2 has role=viewer, but adding members needs owner)."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "Viewer role CAN list documents (viewer+ required) -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token_2}}" }] },
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/documents",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "documents"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    }
  ]
}
