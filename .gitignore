# Secrets
.env
.env.*
!.env.example
!*/.env.example
# apps/UI/.env.development holds only public OIDC client config (API base URL, Keycloak
# realm/client ID) — no secrets; committed so a fresh clone has working local defaults.
!apps/UI/.env.development

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
.uv/

# Node (apps/UI)
node_modules/
dist/
.vite/
*.tsbuildinfo

# Docker
infra/*_data/

# Eval outputs (per specs/architecture/07-evaluation-observability.md)
eval/reports/*
!eval/reports/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Stray marker file Qdrant writes to its working directory if started from repo root
# (020-async-ingestion-pipeline local dev)
.qdrant-initialized

# Local dev process logs / personal notes
*.log
start_services_from_terminal.txt
