# Copy to infra/.env and fill in real values. infra/.env is gitignored — never commit it.

POSTGRES_USER=mmrag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mmrag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_PASSWORD=changeme

MINIO_ROOT_USER=mmrag-admin
MINIO_ROOT_PASSWORD=changeme-min-8-chars
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=mm-rag-documents

# Runtime config — apps/api verifies JWTs against this issuer/audience.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/mm-rag
KEYCLOAK_AUDIENCE=mm-rag-api

# Dev-only: used by scripts/setup_keycloak_dev.py to bootstrap the realm/client/test user via
# Keycloak's Admin REST API, and by tests to mint tokens. apps/api never reads these.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# The following are written by scripts/setup_keycloak_dev.py on first run — leave blank here.
KEYCLOAK_TEST_CLIENT_ID=
KEYCLOAK_TEST_CLIENT_SECRET=
KEYCLOAK_TEST_USERNAME=
KEYCLOAK_TEST_PASSWORD=
KEYCLOAK_TEST_USERNAME_2=
KEYCLOAK_TEST_PASSWORD_2=
